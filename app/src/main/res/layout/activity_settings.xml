<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8EE"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 상단: 뒤로가기 + 제목 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="←"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/settings_title"
                android:textColor="#3B2F2F"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 크기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_size"
                android:textColor="#3B2F2F"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/sizeInput"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:inputType="number"
                android:maxLength="5"
                android:selectAllOnFocus="true"
                android:textSize="18sp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="%"
                android:textColor="#7A6A5A"
                android:textSize="16sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sizeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progressTint="#F28C38"
            android:thumbTint="#F28C38" />

        <!-- 바닥 높이 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_floor"
                android:textColor="#3B2F2F"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/floorInput"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:inputType="number"
                android:maxLength="5"
                android:selectAllOnFocus="true"
                android:textSize="18sp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="dp"
                android:textColor="#7A6A5A"
                android:textSize="16sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/floorSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progressTint="#F28C38"
            android:thumbTint="#F28C38" />

        <!-- 펫이 화면 밖으로 나가면 보이는 빨간 경고 -->
        <TextView
            android:id="@+id/floorWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/warn_pet_hidden"
            android:textColor="#D93025"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 걷는 빈도 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_walk_freq"
                android:textColor="#3B2F2F"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/walkFreqInput"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:inputType="number"
                android:maxLength="5"
                android:selectAllOnFocus="true"
                android:textSize="18sp" />

            <!-- 다른 줄과 숫자 칸 위치를 맞추기 위한 빈 공간 -->
            <Space
                android:layout_width="44dp"
                android:layout_height="0dp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/walkFreqSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progressTint="#F28C38"
            android:thumbTint="#F28C38" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_walk_freq_hint"
            android:textColor="#7A6A5A"
            android:textSize="14sp" />

        <!-- 설정 초기화 -->
        <Button
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:text="@string/settings_reset"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
